{
  "id": "player.youtube",
  "name": "YouTube",
  "version": "1.1.5",
  "apiVersion": 2,
  "description": "Search YouTube, preview audio and download media to your library.",
  "platforms": [
    "android"
  ],
  "permissions": [
    "native.android",
    "ui",
    "playback.control",
    "storage",
    "media.source",
    "library.import"
  ],
  "contributions": [
    { "id": "search", "kind": "search", "label": "YouTube" },
    {
      "id": "share",
      "kind": "share-handler",
      "label": "YouTube"
    }
  ],
  "author": {
    "name": "Player contributors",
    "url": "https://github.com/NoName-Audio/player/graphs/contributors"
  },
  "repository": "https://github.com/NoName-Audio/player-plugin-youtube",
  "homepage": "https://github.com/NoName-Audio/player-plugin-youtube",
  "image": "../assets/youtube.png"
}
