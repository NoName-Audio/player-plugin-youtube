{
  "id": "player.youtube",
  "name": "YouTube",
  "version": "1.1.12",
  "apiVersion": 2,
  "description": "Search YouTube, preview audio and download media to your library.",
  "platforms": [
    "android"
  ],
  "permissions": [
    "native.android",
    "ui",
    "playback.control",
    "storage",
    "secrets",
    "media.source",
    "library.import"
  ],
  "contributions": [
    { "id": "search", "kind": "search", "label": "YouTube" },
    { "id": "like-preview", "kind": "preview-like", "label": "Save preview" },
    { "id": "authorization", "kind": "settings", "label": "YouTube" },
    {
      "id": "sign-in",
      "kind": "page",
      "label": "YouTube sign-in",
      "showInMenu": false,
      "nativePage": {
        "positionAction": "sign-in-position",
        "hideAction": "sign-in-hide",
        "closeAction": "sign-in-close",
        "submitAction": "sign-in-save",
        "submitLabel": "Use this session"
      }
    },
    {
      "id": "share",
      "kind": "share-handler",
      "label": "YouTube"
    }
  ],
  "author": {
    "name": "Player contributors",
    "url": "https://github.com/NoName-Audio/player/graphs/contributors"
  },
  "repository": "https://github.com/NoName-Audio/player-plugin-youtube",
  "homepage": "https://github.com/NoName-Audio/player-plugin-youtube",
  "image": "../assets/youtube.png"
}
